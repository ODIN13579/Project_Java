<mxfile host="app.diagrams.net" modified="2026-10-14T03:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="swiftletcare-ai-pipeline" name="AI Pipeline">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SWIFTLETCARE — AI PROCESSING PIPELINE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="source" value="&lt;b&gt;1. Camera / Video Source&lt;/b&gt;&lt;br&gt;Camera trực tiếp (RTSP) hoặc video thử nghiệm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="115" width="300" height="75" as="geometry"/></mxCell>
        <mxCell id="preprocess" value="&lt;b&gt;2. Frame Acquisition &amp;amp; Preprocessing&lt;/b&gt;&lt;br&gt;Đọc frame • kiểm tra frame hợp lệ&lt;br&gt;Resize / chuẩn hóa đầu vào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="235" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="detect" value="&lt;b&gt;3. Object Detection — YOLOv8&lt;/b&gt;&lt;br&gt;Phát hiện chim yến và đối tượng gây hại&lt;br&gt;Output: class, bbox, confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="birdtrack" value="&lt;b&gt;4A. Bird Tracking — ByteTrack&lt;/b&gt;&lt;br&gt;Gán tracking ID qua các frame&lt;br&gt;Theo dõi vị trí và quỹ đạo chim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="counter" value="&lt;b&gt;5. Entry / Exit Counter&lt;/b&gt;&lt;br&gt;Kiểm tra track qua đường đếm&lt;br&gt;Xác định hướng vào/ra, chống đếm trùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="predator" value="&lt;b&gt;4B. Predator Detection&lt;/b&gt;&lt;br&gt;Lọc đối tượng gây hại theo class và ngưỡng confidence&lt;br&gt;Kiểm tra điều kiện tạo sự kiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="525" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="event" value="&lt;b&gt;6. Event &amp;amp; Snapshot&lt;/b&gt;&lt;br&gt;Chuẩn hóa sự kiện; chống gửi trùng&lt;br&gt;Lưu ảnh bằng chứng và tạo evidence_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="675" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="output" value="&lt;b&gt;7. AI Output / Backend Integration&lt;/b&gt;&lt;br&gt;Chuẩn hóa JSON: event_type, camera_id, timestamp,&lt;br&gt;class, confidence, track_id/count, evidence_ref&lt;br&gt;Gửi HTTPS REST API đến Spring Boot Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="385" width="390" height="115" as="geometry"/></mxCell>
        <mxCell id="backend" value="&lt;b&gt;Spring Boot Backend&lt;/b&gt;&lt;br&gt;Xác thực dữ liệu • xử lý nghiệp vụ&lt;br&gt;Lưu metadata / sự kiện vào Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="565" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="consumers" value="&lt;b&gt;Hệ thống sử dụng kết quả&lt;/b&gt;&lt;br&gt;Database • Dashboard • Alert / Notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="720" width="390" height="75" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Quy tắc xử lý lỗi đầu vào&lt;/b&gt;&lt;br&gt;Nếu mất kết nối hoặc không có frame mới: ghi log/trạng thái camera, thử kết nối lại theo cấu hình; không tạo sự kiện từ frame không hợp lệ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="115" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A5568;" edge="1" parent="1" source="source" target="preprocess"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A5568;" edge="1" parent="1" source="preprocess" target="detect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="detections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A5568;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="detect" target="birdtrack"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="490"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="detection theo class gây hại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="detect" target="predator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="415"/><mxPoint x="400" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B59B32;" edge="1" parent="1" source="birdtrack" target="counter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="count event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B59B32;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="counter" target="output"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="720"/><mxPoint x="800" y="720"/><mxPoint x="800" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B85450;" edge="1" parent="1" source="predator" target="event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="predator event + evidence_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="event" target="output"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="720"/><mxPoint x="810" y="720"/><mxPoint x="810" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;" edge="1" parent="1" source="output" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="backend" target="consumers"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
